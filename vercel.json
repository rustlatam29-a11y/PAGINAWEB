{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!assets/|google.*\\.html$|.*\\.webp$|.*\\.svg$|.*\\.png$|.*\\.jpg$|.*\\.ico$|robots\\.txt$|sitemap\\.xml$|rust-pirata-brasil/|rust-pirata-argentina/|rust-pirata-mexico/|rust-pirata-chile/|rust-pirata-colombia/|rust-pirata-peru/|rust-pirata-uruguay/|rust-pirata-paraguay/|rust-pirata-ecuador/|rust-pirata-bolivia/|rust-pirata-venezuela/|baixar-rust-pirata-brasil/|rust-2275-brasil/|rust-2388-brasil/|rust-pirata-gratis/|rust-pirata-sin-steam/|configurar-servidor-rust/|plugins-oxide-rust/|como-crear-servidor-rust-pirata/|mejores-plugins-rust-pirata/|descargar-rust-pirata/|rust-2275-oldrecoil/|rust-2388-actualizado/|servidores-rust-pirata/|dayz/|comunidade-rust-family/|servidor-rust-family/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "env": {
    "NODE_VERSION": "20.19.0"
  }
}
